    "beta-alert.body" : {
      "comment" : "",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta Versionen können viele Probleme haben.\nVergiss nicht Feedback zu geben, wenn du auf eins triffst.\nDankeschön!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta versions can have many issues.\nDon't forget to give feedback when you run into one.\nThanks!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les versions bêta peuvent contenir de nombreux problèmes.\nN'oubliez pas de nous fournir un retour lorsque vous en rencontrez un. Merci !"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베타 버전을 사용하면 여러 문제를 겪을 수 있습니다.\n문제를 발견하시는 경우 의견을 보내주세요.\n감사합니다!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versões beta podem apresentar vários problemas.\nSe encontrar algum, envie seu feedback.\nObrigado!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta sürümlerinde birçok sorun olabilir.\nBir sorunla karşılaştığınızda geri bildirim vermeyi unutmayın.\nTeşekkürler!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бета-версії можуть мати багато проблем.\nНе забудьте залишити відгук, якщо ви зіткнетеся з однією з них.\nДякуємо!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản Beta có thể có nhiều lỗi\nĐừng quên báo cáo các sự cố nếu bạn gặp nhé.\nCảm ơn bạn!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta版可能有许多问题。不要忘记提交您遇到的问题。谢谢！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta版可能有許多問題。不要忘記回報您遇到的問題。謝謝！"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta版可能有許多問題。不要忘記回報你遇到的問題。多謝！"
          }
        }
      },
      "shouldTranslate" : false
    },
