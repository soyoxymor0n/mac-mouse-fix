    "effect.look-up.hint" : {
      "comment" : "Note: 'Force click' looks a bit weirdly capitalized but it's exactly how Apple spells it on their support website.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhledávání slov ve slovníku, rychlé vyhledávání souborů ve Finderu a další.\n\nFunguje jako silné kliknutí (Force Click) na Apple Trackpadu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlage Wörter im Wörterbuch nach, werfe einen schnellen Blick auf Dateien im Finder, und mehr.\n \nFunktioniert wie ein kräftiger Klick bei einem Apple Trackpad."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look up words in the Dictionary, Quick Look files in Finder, and more.\n \nWorks like a Force click on an Apple Trackpad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar palabras en el Diccionario, Vista Rápida de archivos en el Finder, y más.\n\nFunciona como un clic Forzado en un Apple Trackpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher des mots dans le Dictionnaire, Coup d'œil sur les fichiers dans le Finder et bien plus.\n \nFonctionne comme le clic forcé sur un Trackpad Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca parole nel Dizionario, visualizza l'anteprima rapida dei file nel Finder e altro ancora.\n \nFunziona come un clic forte su un trackpad Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辞書で単語を調べたり、Finderでファイルをクイックルックしたり、他にも様々なことができます。\n\nAppleトラックパッドの強めのクリックと同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사전에서 단어를 찾아보거나, Finder에서 파일을 훑어보는 등의 동작을 수행합니다.\n \n이는 Apple 트랙패드에서 세게 클릭하는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure palavras no Dicionário, visualize arquivos sem abrir no Finder e muito mais.\n \nFunciona como um Force Touch em um Trackpad da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищите слова в словаре, просматривайте файлы в Finder с помощью Quick Look и многое другое.\n\nРаботает как сильное нажатие на трекпаде Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözlükte kelimeleri arayın, Finder'da dosyalara Hızlı Bakın ve daha fazlasını yapın.\n \nApple İzleme Dörtgeninde Sert Tıklama gibi çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукайте слова у словнику, файли швидкого пошуку у Finder тощо. \n\nПрацює як Сильне клацання на трекпеді Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra cứu từ trong Dictionary, xem nhanh tệp trong Finder, và nhiều hơn.\n \nHoạt động như nhấn, kèm lực trên Apple Trackpad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在词典中查询单词，在方达中快速预览文件等\n\n类似于妙控板的用力点击"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "查詢辭典、於Finder中「快速查看」等。\n \n作用相當於在Apple觸控式軌跡板上用一指用力長按。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "查詢辭典、在Finder「快速查看」等。\n \n作用相當於在Apple觸控板上用一指用力長按。"
          }
        }
      }
    },
