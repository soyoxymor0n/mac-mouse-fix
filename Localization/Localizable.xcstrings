    "app-presets.override.message" : {
      "comment" : "Message of the alert shown when ticked rows of the recommended setup would replace actions the app tab already has. %@ is the list of rows that would be replaced, for example 'Button 5 (Toggle video)'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These settings in this tab will be replaced:\n%@\n\nOnly Add keeps them and adds only the new rows."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato nastavení v této záložce budou nahrazena:\n%@\n\nVolba Jen přidat je ponechá a přidá jen nové řádky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen in diesem Tab werden ersetzt:\n%@\n\nMit „Nur hinzufügen“ bleiben sie erhalten und nur die neuen Zeilen kommen dazu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reemplazarán estos ajustes de esta pestaña:\n%@\n\nCon «Solo añadir» se conservan y solo se añaden las filas nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages de cet onglet seront remplacés :\n%@\n\nAjouter seulement les conserve et n'ajoute que les nouvelles lignes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni del pannello verranno sostituite:\n%@\n\nCon Aggiungi soltanto restano come sono e vengono aggiunte solo le righe nuove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタブの次の設定が置き換えられます:\n%@\n\n「追加のみ」を選ぶと、今の設定は残したまま新しい行だけを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 탭의 다음 설정이 대체됩니다:\n%@\n\n추가만 하기를 선택하면 기존 설정은 그대로 두고 새 행만 추가합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse innstillingene i fanen blir erstattet:\n%@\n\nBare legg til beholder dem og legger bare til de nye radene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes ajustes desta aba serão substituídos:\n%@\n\nSó Adicionar mantém esses ajustes e adiciona apenas as linhas novas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти настройки на вкладке будут заменены:\n%@\n\n«Только добавить» сохранит их и добавит лишь новые строки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sekmedeki şu ayarlar değiştirilecek:\n%@\n\nYalnızca Ekle seçeneği bunları korur ve sadece yeni satırları ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці налаштування на вкладці буде замінено:\n%@\n\n«Лише додати» залишить їх і додасть тільки нові рядки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cài đặt sau trong tab này sẽ bị thay thế:\n%@\n\nChọn Chỉ thêm để giữ chúng và chỉ thêm các dòng mới."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此標籤頁中的以下設定會被取代：\n%@\n\n選擇「只加入」會保留這些設定，只加入新的列。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此标签页中的以下设置将被替换：\n%@\n\n选择“仅添加”会保留这些设置，只添加新的行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此標籤頁中的這些設定將被取代：\n%@\n\n選擇「僅加入」會保留這些設定，只加入新的列。"
          }
        }
      }
    },
