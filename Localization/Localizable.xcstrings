    "forbidden-capture-toast.1" : {
      "comment" : "Note: This message shows when the user tries to assign an action to the primary mouse button (aka left click) inside Mac Mouse Fix.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Primární tlačítko myši** nemůže být použito\nProsím zvolte jiné tlačítko."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Primäre Maustaste** kann nicht verwendet werden\nBitte versuche eine andere Taste"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Primary Mouse Button** can't be used\nPlease try another button"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**El botón primario del ratón** no se puede usar\nPor favor, prueba otro botón"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le **bouton principal de la souris** ne peut pas être utilisé\nVeuillez essayer un autre bouton"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il **pulsante primario del mouse** non può essere usato\nProva con un altro pulsante"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインのマウスボタンは割り当てを変更できません。別のボタンを試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**마우스 주 버튼**은 사용할 수 없습니다.\n다른 버튼으로 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**O Botão Primário do Mouse** não pode ser utilizado\nTente outro botão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Основная кнопка мыши** не может быть использована\nПожалуйста, попробуйте другую кнопку"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Birincil Fare Düğmesi** kullanılamaz\nLütfen başka bir düğme deneyin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Основну кнопку миші** неможливо використовувати\nБудь ласка, спробуйте іншу кнопку"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Nút chính** không thể được áp dụng\nVui lòng chọn một nút khác"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不能使用**鼠标主键**\n请换一个按键再试"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不能使用**主要滑鼠按鈕**\n請換一個按鈕再試"
          }
        },
        "zh-HK" : {
