    "community-share.problem.invalid-rows" : {
      "comment" : "Share sheet error. %ld is the number of rows that break the rules.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This tab can't be shared, because %ld of its buttons can't be shared. Only keyboard shortcuts without modifier buttons can be shared, and Quit, Log Out and Force Quit are never shared."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto záložku nelze sdílet, protože některá její tlačítka (%ld) sdílet nejde. Sdílet lze jen klávesové zkratky bez modifikačních tlačítek a Ukončit, Odhlásit a Vynutit ukončení se nesdílí nikdy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tab kann nicht geteilt werden, weil %ld seiner Tasten nicht geteilt werden können. Teilen lassen sich nur Tastaturkurzbefehle ohne zusätzlich gehaltene Maustaste, und Beenden, Abmelden und Sofort beenden werden nie geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pestaña no se puede compartir porque %ld de sus botones no se pueden compartir. Solo se pueden compartir atajos de teclado sin botones modificadores, y Salir, Cerrar sesión y Forzar salida nunca se comparten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de partager cet onglet, car %ld de ses boutons ne peuvent pas être partagés. Seuls les raccourcis clavier sans bouton modificateur peuvent être partagés, et Quitter, Fermer la session et Forcer à quitter ne sont jamais partagés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo pannello non si può condividere, perché %ld dei suoi pulsanti non si possono condividere. Si possono condividere solo scorciatoie da tastiera senza pulsanti di modifica, e Esci, Logout e Uscita forzata non vengono mai condivisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタブのボタンのうち%ld個が共有できないため、このタブは共有できません。共有できるのは修飾ボタンを使わないキーボードショートカットだけです。また、「終了」「ログアウト」「強制終了」は共有されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 탭의 버튼 중 %ld개를 공유할 수 없으므로 이 탭은 공유할 수 없습니다. 보조 버튼 없이 쓰는 키보드 단축키만 공유할 수 있으며, 종료, 로그아웃, 강제 종료는 어떤 경우에도 공유되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne fanen kan ikke deles, fordi %ld av knappene i den ikke kan deles. Bare tastatursnarveier uten modifikatorknapper kan deles, og Avslutt, Logg ut og Tvangsavslutt deles aldri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aba não pode ser compartilhada, porque %ld dos botões dela não podem ser compartilhados. Só atalhos de teclado sem botões modificadores podem ser compartilhados, e Encerrar, Finalizar Sessão e Forçar Encerrar nunca são compartilhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой вкладкой нельзя поделиться: кнопок, которые нельзя отправить, — %ld. Отправить можно только сочетания клавиш без кнопок-модификаторов, а «Завершить», «Завершить сеанс» и «Завершить принудительно» не отправляются никогда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sekme paylaşılamaz, çünkü düğmelerinden %ld tanesi paylaşılamaz. Yalnızca değiştirici düğme içermeyen klavye kısayolları paylaşılabilir; Çık, Çıkış Yap ve Zorla Çık ise hiçbir zaman paylaşılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цією вкладкою не можна поділитися, бо %ld її кнопок не підходять для спільних наборів. Ділитися можна лише клавіатурними скороченнями без кнопок-модифікаторів, а «Завершити», «Вийти» і «Примусово завершити» не передаються ніколи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể chia sẻ tab này, vì có %ld nút trong đó không chia sẻ được. Chỉ chia sẻ được các phím tắt không kèm nút bổ trợ, và Thoát, Đăng xuất, Buộc thoát không bao giờ được chia sẻ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
