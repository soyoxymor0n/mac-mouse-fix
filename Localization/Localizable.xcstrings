{
  "sourceLanguage" : "en",
  "strings" : {
    "accessibility.settings-link.pre-ventura" : {
      "comment" : "Will be used in a context like this: \n   1. Open 'Security & Privacy' Preferences\n   2. Switch on 'Mac Mouse Fix Helper'\n\nBackground info: 'System Preferences' were renamed to 'System Settings' in macOS Ventura. The translation for Ventura and later is defined by 46z-Nd-nh4.title and other entries in AuthorizeAccessibilityView. This here is the string for earlier versions.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete nastavení 'Soukromí a zabezpečení'"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die 'Sicherheit & Datenschutz' Einstellungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open 'Security & Privacy' Preferences"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir las Preferencias 'Seguridad y Privacidad'"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir les préférences « Sécurité et confidentialité »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri le preferenze 'Sicurezza e Privacy'"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'プライバシーとセキュリティ'設定を開く"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'보안 및 개인 정보 보호' 설정 열기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne \"Sikkerhet og personvern\"-innstillinger"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir 'Privacidade e Segurança' em Ajustes do Sistema"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть настройки «Конфиденциальность и безопасность»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Güvenlik ve Gizlilik' Ayarlarını Açın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте параметр 'Приватність і безпека'"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở thiết lập 'Security & Privacy'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“隐私与安全性”偏好设置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開「隱私權與安全性」偏好設定"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「私隱與保安」偏好設定"
          }
        }
      }
    },
    "add-field.explainer.click" : {
      "comment" : "Line in the gestures popover that opens from the question mark in the add field. Explains the gesture 'Click'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and release a mouse button."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte a uvolněte tlačítko myši."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Maustaste drücken und loslassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa y suelta un botón del ratón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un bouton de la souris, puis relâchez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi e rilascia un pulsante del mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスのボタンを押して離します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 버튼을 눌렀다 뗍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og slipp en museknapp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione e solte um botão do mouse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и отпустите кнопку мыши."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fare düğmesine basıp bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть і відпустіть кнопку миші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn rồi thả một nút chuột."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下再放開滑鼠按鈕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下并松开一个鼠标按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下並放開滑鼠按鈕。"
          }
        }
      }
    },
    "add-field.explainer.click-and-drag" : {
      "comment" : "Line in the gestures popover that opens from the question mark in the add field. Explains the gesture 'Click and Drag'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press a mouse button, keep it held and move the mouse."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte tlačítko myši, držte ho a pohybujte myší."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Maustaste gedrückt halten und dabei die Maus bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa un botón del ratón, mantenlo pulsado y mueve el ratón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un bouton de la souris, gardez-le enfoncé et déplacez la souris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi un pulsante del mouse, tienilo premuto e muovi il mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスのボタンを押したまま、マウスを動かします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 버튼을 누른 채로 마우스를 움직입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en museknapp, hold den inne og beveg musen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione um botão do mouse, mantenha-o pressionado e mova o mouse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку мыши и, не отпуская ее, двигайте мышь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fare düğmesine basın, basılı tutun ve fareyi hareket ettirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть кнопку миші, утримуйте її й рухайте мишею."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ một nút chuột và di chuyển chuột."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住滑鼠按鈕，同時移動滑鼠。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住一个鼠标按键，同时移动鼠标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住滑鼠按鈕，同時移動滑鼠。"
          }
        }
      }
    },
    "add-field.explainer.click-and-scroll" : {
      "comment" : "Line in the gestures popover that opens from the question mark in the add field. Explains the gesture 'Click and Scroll'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press a mouse button, keep it held and scroll the wheel."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte tlačítko myši, držte ho a otáčejte kolečkem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Maustaste gedrückt halten und dabei am Rad scrollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa un botón del ratón, mantenlo pulsado y gira la rueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un bouton de la souris, gardez-le enfoncé et tournez la molette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi un pulsante del mouse, tienilo premuto e gira la rotella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスのボタンを押したまま、ホイールをスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 버튼을 누른 채로 휠을 스크롤합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en museknapp, hold den inne og rull med hjulet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione um botão do mouse, mantenha-o pressionado e role a roda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку мыши и, не отпуская ее, крутите колесо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fare düğmesine basın, basılı tutun ve tekerleği kaydırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть кнопку миші, утримуйте її й прокручуйте коліщатко."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ một nút chuột và lăn bánh xe cuộn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住滑鼠按鈕，同時捲動滾輪。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住一个鼠标按键，同时滚动滚轮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住滑鼠按鈕，同時捲動滾輪。"
          }
        }
      }
    },
    "add-field.explainer.closing" : {
      "comment" : "Last line in the gestures popover that opens from the question mark in the add field",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each gesture can be assigned to any button, globally or for one app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé gesto můžete přiřadit libovolnému tlačítku, globálně nebo jen pro jednu aplikaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Geste lässt sich jeder Taste zuweisen, global oder für eine einzelne App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes asignar cada gesto a cualquier botón, para todas las aplicaciones o solo para una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque geste peut être attribué à n'importe quel bouton, pour toutes les apps ou pour une seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi assegnare ogni gesto a qualsiasi pulsante, per tutte le app o per una sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのジェスチャもすべてのボタンに割り当てられます。全体でも、アプリごとでも設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 제스처는 어떤 버튼에든 지정할 수 있습니다. 모든 앱에 적용하거나 앱 하나에만 적용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gest kan tilordnes hvilken som helst knapp, globalt eller for én app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada gesto pode ser atribuído a qualquer botão, em todos os apps ou em um só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой жест можно назначить на любую кнопку — для всех приложений или для одного."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her hareket herhangi bir düğmeye atanabilir; tüm uygulamalar için ya da tek bir uygulama için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен жест можна призначити будь-якій кнопці, для всіх програм або для однієї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi cử chỉ đều gán được cho bất kỳ nút nào, cho mọi ứng dụng hoặc chỉ một ứng dụng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個手勢都可以指派給任何按鈕，可全域使用，也可只用於一個App。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每种手势都可以分配给任意按键，可全局使用，也可只用于某个 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每種手勢都能指定給任何按鈕，可套用到全部或單一應用程式。"
          }
        }
      }
    },
    "add-field.explainer.double-click" : {
      "comment" : "Line in the gestures popover that opens from the question mark in the add field. Explains the gesture 'Double Click'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press a mouse button twice in quick succession."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte tlačítko myši dvakrát rychle po sobě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Maustaste zweimal schnell hintereinander drücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa un botón del ratón dos veces seguidas, rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
