    "precise-scrolling-hint" : {
      "comment" : "The mention of keyboard modifiers is meant to draw attention to the keyboard modifers section of the UI which appears right below. (Search for: 'Scrolling > Keyboard Modifiers')",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesné posouvání i bez použití modifikační klávesy, *pomalým* pohybem rolovacího kolečka"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle auch ohne Sondertasten präzise, indem du das\nScrollrad *langsam* bewegst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll precisely, even without a keyboard modifier, by moving the scroll wheel *slowly*"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate con precisión, incluso sin un modificador de teclado, moviendo la rueda de desplazamiento&nbsp;*lentamente*"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Défiler précisement, même sans un raccourci clavier,\nen bougeant la molette de défilement *doucement*"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri con precisione, anche senza un tasto di modifica, muovendo la rotellina *lentamente*"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロールホイールを*ゆっくり*回すことで、修飾キーを使わずに精密なスクロールが可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스크롤을 *천천히* 움직이는 경우, 보조 키를 사용하지 않더라도\n정밀하게 스크롤합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rull presist, selv uten tastaturmodifikator, ved å bevege rullehjulet *sakte*"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role com precisão, mesmo sem um modificador de teclado,\nmovendo a roda de rolagem *lentamente*"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручивайте точно, даже без модификатора клавиатуры, *медленно* перемещая колесико прокрутки"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırma tekerleğini *yavaşça* hareket ettirerek, klavye değiştiricisi tuşu olmadan bile hassas bir şekilde&nbsp;kaydırın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручуйте точно навіть без модифікатора, повільно повертаючи *коліщатко*"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn chính xác, dù không kèm theo một phím bổ sung, bằng cách di chuyện con lăn *thật chậm*"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*慢慢*滚动滚轮来精准滚动，甚至无需键盘修饰键"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*慢慢*滾動滾輪來精確捲動，甚至無需鍵盤變更鍵"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "*慢慢*滾動滾輪來精確捲動，甚至無需鍵盤變更鍵"
          }
        }
      }
    },
