    "community-share.problem.sensitive" : {
      "comment" : "Share sheet error for apps on the sensitive list.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setups for this app can't be shared, because the app's name could reveal health, dating, religious, political or financial information."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení pro tuto aplikaci nelze sdílet, protože z jejího názvu by se dalo vyčíst něco o zdraví, seznamování, víře, politice nebo financích."
          }
