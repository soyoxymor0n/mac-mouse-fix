          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira contenido en Mapas de Apple y otras aplicaciones\n\nFunciona como girar con 2 dedos en un Apple Trackpad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
