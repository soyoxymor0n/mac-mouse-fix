        }
      }
    },
    "macos-scrolling-hint" : {
      "comment" : "%1$@ will be the name of the System Settings app.\n\nConsider putting the destination in the System Settings on its own line just like English to make the text easier to scan.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte rychlost zde\n[%1$@ > Myš > Rychlost posouvání](%2$@)"
