    "app-tabs.remove.alert.message" : {
      "comment" : "Informative text of the alert that removes an app tab. Only shown if the tab has buttons.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its button settings are deleted too. Global settings are not affected."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smažou se i nastavení jejích tlačítek. Globálních nastavení se to nedotkne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tasteneinstellungen des Tabs werden mitgelöscht. Globale Einstellungen bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
