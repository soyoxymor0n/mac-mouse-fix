    "community-setups.error" : {
      "comment" : "Shown in the Community setups popover when the setups could not be downloaded and there is no saved copy.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The community setups could not be loaded. Check your internet connection and try again. Your own settings are not affected."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení komunity se nepodařilo načíst. Zkontrolujte připojení k internetu a zkuste to znovu. Vašich vlastních nastavení se to nedotkne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Belegungen der Community konnten nicht geladen werden. Prüfe deine Internetverbindung und versuche es noch einmal. Deine eigenen Einstellungen bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido cargar las configuraciones de la comunidad. Comprueba tu conexión a internet y vuelve a intentarlo. Tus propios ajustes no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les configurations de la communauté. Vérifiez votre connexion Internet et réessayez. Vos propres réglages ne sont pas touchés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile caricare le configurazioni della community. Controlla la connessione a internet e riprova. Le tue impostazioni restano invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミュニティの設定を読み込めませんでした。インターネット接続を確認して、もう一度お試しください。ご自分の設定は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커뮤니티 구성을 불러올 수 없습니다. 인터넷 연결을 확인한 후 다시 시도하세요. 사용자 설정은 영향을 받지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fellesskapsoppsettene kunne ikke lastes inn. Sjekk internettforbindelsen og prøv igjen. Dine egne innstillinger påvirkes ikke."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar as configurações da comunidade. Verifique sua conexão com a internet e tente de novo. Seus próprios ajustes não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить наборы сообщества. Проверьте подключение к интернету и попробуйте снова. Ваши настройки не затронуты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topluluk yapılandırmaları yüklenemedi. İnternet bağlantınızı kontrol edip tekrar deneyin. Kendi ayarlarınız etkilenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити набори спільноти. Перевірте підключення до інтернету й спробуйте ще раз. Ваші власні налаштування не зміняться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tải được cấu hình cộng đồng. Hãy kiểm tra kết nối internet rồi thử lại. Cài đặt của bạn không bị ảnh hưởng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入社群設定。請檢查你的互聯網連線，然後再試一次。你自己的設定不受影響。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法载入社区设置。请检查网络连接后重试。您自己的设置不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入社群設定。請檢查網路連線後再試一次。您自己的設定不受影響。"
          }
        }
      }
    },
