    "license-toast.unknown-key" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**' je neplatný licenční klíč.\n\nUjistěte se, že zadáváte klíč k Mac Mouse Fix NG přesně takový, jaký jste obdrželi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**' ist kein gültiger Lizenzschlüssel\n\nStelle sicher, dass du deinen Mac Mouse Fix NG Schlüssel genau so eingibst, wie du ihn erhalten hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**' is not a valid license key\n\nMake sure you enter your Mac Mouse Fix key exactly as you received it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**' no es una clave de licencia válida\n\nAsegúrate de ingresar tu clave de Mac Mouse Fix NG exactamente como la recibiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« **%@** » n'est pas une clé de licence connue\n\nVeuillez essayer une clé différente"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**' non è una chiave di licenza valida\n\nAssicurati di inserire la tua chiave di Mac Mouse Fix NG esattamente come l'hai ricevuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**'は有効なライセンスキーではありません\n\nMac Mouse Fix NGのライセンスキーを、受け取った通りに正確に入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'**%@**' 키는 올바르지 않은 라이센스 키입니다.\n\n다시 입력하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'**%@**' não é uma chave de licença válida\n\nTente uma chave diferente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«**%@**» не является действительным лицензионным ключом\n\nУбедитесь, что вы ввели ключ Mac Mouse Fix NG точно так, как его получили."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*'%@'** geçerli bir lisans anahtarı değildir\n\nMac Mouse Fix NG anahtarınızı aldığınız gibi yazdığınızdan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**' не є дійсним ключем\n\nПереконайтеся, що ви ввели ключ для Mac Mouse Fix NG саме так, як ви його отримали."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'**%@**' không phải là khoá kích hoạt đúng.\n\nHãy chắc chắn bạn dùng đúng mã Mac Mouse Fix NG mà bạn đã nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“**%@**”并不是有效的许可证。\n请确认您输入的许可证与您收到的一致"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「**%@**」並不是已知的許可證。\n請換一個許可證再試。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「**%@**」並不是已知的許可證。\n請換一個許可證再試。"
          }
        }
      }
    },
    "license-toast.unknown-reason" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivování vaší licence selhalo z **neznámého důvodu**.\n\nProsím **ohlaste chybu** [zde](%@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aktivierung deiner Lizenz ist aus **unbekannten Gründen** gescheitert\n\nBitte schreibe [hier](%@) einen **Fehlerbericht**"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activating your license failed for **unknown reasons**\n\nPlease write a **Bug Report** [here](%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La activación de tu licencia falló por **razones desconocidas**\n\nPor favor, escribe un **Reporte de error** [aquí](%@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'activation de votre licence a échoué pour des *raisons inconnues**\n\nVeuillez **signaler le bug** [ici](%@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivazione della licenza non riuscita per **motivi sconosciuti**\n\nScrivi una **segnalazione di bug** [qui](%@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**原因不明のエラー**により、ライセンスの有効化に失敗しました\n\n[こちら](%@)から**バグ報告**をお願いいたします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**알 수 없는 이유**로 라이센스를 활성화하지 못했습니다.\n\n[여기](%@)에서 **버그 제보**를 작성해주십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ativação da sua Licença falhou por **motivos desconhecidos**\n\nPor favor, envie um **Relatório de Bug** [aqui](%@)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активация лицензии не удалась по **неизвестным причинам**.\n\nПожалуйста, напишите **отчет об ошибке** [здесь](%@)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Bilinmeyen sebepler nedeniyle** lisans aktivasyonunuz başarısız oldu\n\nLütfen [buradan](%@) bir **hata raporu** oluşturun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активація вашої ліцензії не вдалася з **невідомих причин**\n\nБудь ласка, надішліть **Звіт про помилку** [тут](%@)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích hoạt thất bạn do **lỗi không xác định**\n\nVui lòng gửi một **Báo cáo lỗi** [tại đây](%@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于**未知的原因**，许可证激活失败。\n\n请到[这里](%@)提交**错误报告**"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "由於**未知的原因**，許可證啟用失敗。\n\n請到[這裡](%@)回報**錯誤**"
          }
        },
        "zh-HK" : {
