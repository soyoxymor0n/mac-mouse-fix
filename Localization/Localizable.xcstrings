    "scroll-effect.app-switcher.hint" : {
      "comment" : "",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychle přepíná mezi otevřenými aplikacemi\n\nFunguje jako přidržení klávesy Command (⌘) a současném stisku klávesy Tab (⇥) na vaší klávesnici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle schnell zischen offenen Apps\n \nFunktioniert wie auf deiner Tastatur die Befehlstaste (⌘) zu halten und dann Tab (⇥) zu drücken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quickly switch between open apps\n \nWorks like holding Command (⌘) and then pressing Tab (⇥) on your keyboard"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia rápidamente entre las aplicaciones abiertas\n\nFunciona como mantener pulsado Comando (⌘) y luego pulsar Tab (⇥) en tu teclado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculer rapidement entre les apps ouvertes\n \nFonctionne comme en maintenant Commande (⌘) et en appuyant sur Tab (⇥) sur votre clavier"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa rapidamente da un'app aperta all'altra\n \nFunziona come tenere premuto Comando (⌘) e poi premere Tab (⇥) sulla tastiera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いているアプリをすばやく切り替える\n\nキーボードでCommand(⌘)を押しながらTab(⇥)を押すのと同じように動作します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열려있는 앱 사이를 빠르게 전환합니다.\n \n이는 키보드의 Command (⌘) 키 및 Tab (⇥) 키를 누르는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne rapidamente entre aplicativos abertosem Funciona como segurar Command (⌘) e pressionar Tab (⇥) no teclado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрое переключение между открытыми приложениями\n \nРаботает так же, как удержание клавиши Command (⌘) и нажатие клавиши Tab (⇥) на клавиатуре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık uygulamalar arasında hızlıca geçiş yapın\n \nKlavyenizde Command (⌘) tuşunu basılı tutup ardından Tab (⇥) tuşuna basmak gibi çalışır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидко перемикайтеся між відкритими програмами\n \nПрацює як утримування Command (⌘) та клацання Tab (⇥) на клавіатурі"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhanh chóng chuyển đổi giữa các ứng dụng đang mở\n \nHoạt động như giữ phím Command (⌘) và nhấn Tab (⇥) trên bàn phím"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已打开的应用程序之间快速切换\n \n作用相当于在您的键盘上按住Command（⌘）然后按下Tab（⇥）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在打開的應用程式之間快速切換\n \n作用相當於在您的鍵盤上按住Command（⌘）然後按下Tab（⇥）"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已開啟的應用程式之間快速切換\n \n作用相當於在你的鍵盤上按住Command（⌘）然後按下Tab（⇥）"
          }
        }
      }
    },
