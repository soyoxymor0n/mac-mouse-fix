    "effect.click.middle.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevírání odkazů na nové kartě, vkládání textu v Terminálu a další.\n\nFunguje to jako kliknutí prostředním tlačítkem myši (také nazývaným kolečko nebo tlačítko myši 3) na standardní myši."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Links in einem neuen Tab, setze Text im Terminal ein, und mehr.\n \nFunktioniert wie das Klicken der mittleren Maustaste (auch genannt Scrollradtaste oder Maustaste 3) bei einer Standard-Maus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open links in a new tab, paste text in the Terminal, and more.\n \nWorks like clicking the middle mouse button (also called scroll wheel button or mouse button 3) on a standard mouse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir enlaces en una pestaña nueva, pegar texto en la Terminal, y más.\n\nFunciona como hacer clic en el botón central del ratón (también llamado botón de la rueda de desplazamiento o botón 3 del ratón) en un ratón estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrir les liens dans un nouvel onglet, coller du texte dans le Terminal et bien plus.\n \nFonctionne comme le clic sur le Bouton central de la souris (aussi appelé bouton de la molette de défilement ou Bouton de souris 3) sur une souris standard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri i link in una nuova scheda, incolla il testo nel Terminale e altro ancora.\n \nFunziona come fare clic con il pulsante centrale del mouse (chiamato anche pulsante della rotellina o pulsante 3 del mouse) su un mouse standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを新しいタブで開く、ターミナルにテキストを貼り付けるなど、さまざまな操作が可能です。\n \n一般的なマウスの中央ボタン（ホイールボタンやマウスボタン3とも呼ばれます）をクリックしたときと同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "링크를 새로운 탭에서 열거나, 터미널에서 텍스트를 붙여넣는 등의 동작을 수행합니다.\n \n이는 표준 마우스에서 마우스 가운데 버튼(또는 스크롤 휠 버튼 및 마우스 3번 버튼)를 클릭하는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra links em uma nova aba, cole texto no Terminal e muito mais.\n \nFunciona como clicar Botão do Meio do Mouse (também chamado de Botão da de Rolagem ou 3º Botão do Mouse) em um Mouse padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте ссылки в новой вкладке, вставляйте текст в Терминале и многое другое.\n\nРаботает как нажатие средней кнопки мыши (также называемой кнопкой колеса прокрутки или кнопкой мыши 3) на стандартной мыши."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıları yeni sekmede açın, Terminal'e metin yapıştırın ve daha fazlasını yapın.\n \nOrta Fare Düğmesi (Kaydırma Tekerleği Düğmesi veya Fare Düğmesi 3 olarak da adlandırılır)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкривайте посилання в нових вкладках, уставляйте текст у Термінал тощо.\n \nПрацює як клацання середньою кнопкою миші (також називається коліщатком або кнопкою 3) на звичайній миші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở liên kết trong thẻ mới, dán chữ vào Terminal, và nhiều hơn.\n \nHoạt động như kích vào nút Nút giữa (còn gọi là con lăn hoặc nút số 3) trên chuột thông thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以新标签页打开链接、在“终端”中粘贴文字等。\n \n作用相当于在标准鼠标上点按鼠标中键（又称鼠标滚轮键或鼠标按键３）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以新標籤頁打開連結、於終端機中貼上文字等。\n \n作用相當於在標準滑鼠上按一下滑鼠中間鍵（又稱滑鼠滾輪按鈕或滑鼠按鈕３）。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以新分頁開啟連結、在終端機裏貼上文字等。\n \n作用相當於在標準滑鼠上按一下滑鼠中間鍵（又稱滑鼠滾輪按鈕或滑鼠按鈕３）。"
          }
        }
      }
    },
