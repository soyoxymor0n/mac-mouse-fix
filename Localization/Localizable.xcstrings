    "community-settings.delete-failed.not-found" : {
      "comment" : "Alert text when the server answered that the setup doesn't exist.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server doesn't know this setup. It may have been deleted already. It stays in the list on this Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server toto nastavení nezná. Možná už bylo smazáno. V seznamu na tomto Macu zůstává."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server kennt diese Belegung nicht. Vielleicht wurde sie schon gelöscht. Auf diesem Mac bleibt sie in der Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no conoce esta configuración. Puede que ya se haya eliminado. Sigue en la lista de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne connaît pas cette configuration. Elle a peut-être déjà été supprimée. Elle reste dans la liste sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non conosce questa configurazione. Forse è già stata eliminata. Resta nell'elenco su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバにこの設定が見つかりません。すでに削除されている可能性があります。このMacのリストには残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 이 구성이 없습니다. 이미 삭제되었을 수 있습니다. 이 Mac의 목록에는 그대로 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren kjenner ikke til dette oppsettet. Det kan allerede være slettet. Det blir stående i listen på denne Macen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor não conhece esta configuração. Talvez ela já tenha sido apagada. Ela continua na lista deste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не знает этот набор. Возможно, он уже удален. В списке на этом Mac он останется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu bu yapılandırmayı tanımıyor. Daha önce silinmiş olabilir. Bu Mac'teki listede kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не знає цього набору. Можливо, його вже видалено. Він залишається у списку на цьому Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ không tìm thấy cấu hình này. Có thể nó đã bị xóa rồi. Nó vẫn nằm trong danh sách trên máy Mac này."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器找不到此設定，它可能已被刪除。此設定會保留在此Mac的列表中。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器上没有此设置，可能已被删除。它会保留在这台 Mac 的列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器上找不到這組設定，可能已經刪除了。它會保留在這台Mac的清單中。"
          }
        }
      }
    },
    "community-settings.delete-failed.network" : {
      "comment" : "Alert text when deleting failed because of the network.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server couldn't be reached. The setup stays in the list, so you can try again later."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server se nepodařilo kontaktovat. Nastavení v seznamu zůstává, takže to můžete zkusit později znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server war nicht erreichbar. Die Belegung bleibt in der Liste, du kannst es also später noch einmal versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conectar con el servidor. La configuración sigue en la lista, así que puedes volver a intentarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur. La configuration reste dans la liste, vous pourrez donc réessayer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server. La configurazione resta nell'elenco, così puoi riprovare più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバに接続できませんでした。設定はリストに残るので、あとでもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 연결할 수 없습니다. 구성이 목록에 남아 있으므로 나중에 다시 시도할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikk ikke kontakt med serveren. Oppsettet blir stående i listen, så du kan prøve igjen senere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar ao servidor. A configuração continua na lista, então você pode tentar de novo mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с сервером. Набор останется в списке, и можно будет попробовать позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuya ulaşılamadı. Yapılandırma listede kalır, daha sonra tekrar deneyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося з’єднатися із сервером. Набір залишається у списку, тож можна спробувати пізніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không kết nối được tới máy chủ. Cấu hình vẫn nằm trong danh sách để bạn thử lại sau."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連接伺服器。設定會保留在列表中，你可以稍後再試。"
