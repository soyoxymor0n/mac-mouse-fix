    "app-presets.review.duplicate" : {
      "comment" : "Warning in the review sheet. Shown when two checked rows use the same mouse button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two checked rows use the same button. Change one of them to add these rows."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dva zaškrtnuté řádky používají stejné tlačítko. Aby šly přidat, změňte u jednoho z nich tlačítko."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei ausgewählte Zeilen verwenden dieselbe Taste. Ändere eine davon, um die Zeilen hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos filas marcadas usan el mismo botón. Cambia una para poder añadirlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux lignes cochées utilisent le même bouton. Changez-en une pour ajouter ces lignes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due righe selezionate usano lo stesso pulsante. Cambiane una per poterle aggiungere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックした2つの行が同じボタンを使っています。どちらかを変更すると追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체크된 두 행이 같은 버튼을 사용합니다. 추가하려면 둘 중 하나를 변경하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To avkryssede rader bruker samme knapp. Endre en av dem for å legge til radene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas linhas marcadas usam o mesmo botão. Altere uma delas para adicionar estas linhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Две отмеченные строки используют одну и ту же кнопку. Измените одну из них, чтобы добавить строки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretli iki satır aynı düğmeyi kullanıyor. Bu satırları eklemek için birini değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два позначені рядки використовують ту саму кнопку. Змініть один із них, щоб додати ці рядки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dòng đã chọn dùng cùng một nút. Hãy đổi một trong hai để thêm các dòng này."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有兩個已勾選的列使用同一個按鈕。請更改其中一個，才可加入這些列。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有两行勾选的项目使用了同一个按键。请修改其中一行，然后再添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
