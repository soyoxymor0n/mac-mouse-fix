        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As configurações deste app não podem ser compartilhadas, porque o nome do app pode revelar informações de saúde, relacionamentos, religião, política ou finanças."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наборами для этого приложения делиться нельзя: его название может раскрыть сведения о здоровье, знакомствах, религии, политике или финансах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamanın yapılandırmaları paylaşılamaz, çünkü uygulamanın adı sağlık, flört, din, siyaset veya mali durumla ilgili bilgileri açığa çıkarabilir."
