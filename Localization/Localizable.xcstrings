    "app-tabs.restore.alert.message" : {
      "comment" : "Informative text of the alert that deletes the buttons of an app tab.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tab stays, so you can assign buttons again. Global settings are not affected."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záložka zůstane, takže můžete tlačítka přiřadit znovu. Globálních nastavení se to nedotkne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
