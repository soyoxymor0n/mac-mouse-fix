    "community-share.done" : {
      "comment" : "Shown in the share sheet after sending. %@ is the record ID, for example s_3f2a…",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared. Record ID: %@\nIt waits for review and isn't public until it is published. You can delete it at any time in the General tab under Shared setups."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdíleno. ID záznamu: %@\nČeká na kontrolu a veřejné bude až po zveřejnění. Smazat ho můžete kdykoli v záložce Obecné v části Sdílená nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilt. Eintrags-ID: %@\nSie wartet auf die Prüfung und ist erst öffentlich, wenn sie veröffentlicht wurde. Löschen kannst du sie jederzeit im Tab „Allgemein“ unter „Geteilte Belegungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartida. ID del registro: %@\nQueda pendiente de revisión y no será pública hasta que se publique. Puedes eliminarla cuando quieras en la pestaña General, en Configuraciones compartidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagée. ID de l'enregistrement : %@\nElle attend d'être vérifiée et ne sera publique qu'une fois publiée. Vous pouvez la supprimer à tout moment dans l'onglet Général, sous Configurations partagées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivisa. ID record: %@\nOra è in attesa di controllo e non è pubblica finché non viene pubblicata. Puoi eliminarla quando vuoi nel pannello Generale, sotto Configurazioni condivise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有しました。レコードID: %@\n確認待ちの状態で、公開されるまでは一般には表示されません。「一般」タブの「共有した設定」から、いつでも削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유했습니다. 레코드 ID: %@\n검토를 기다리는 중이며, 게시되기 전까지는 공개되지 않습니다. 일반 탭의 공유한 구성에서 언제든지 삭제할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delt. Post-ID: %@\nOppsettet venter på gjennomgang og er ikke offentlig før det publiseres. Du kan når som helst slette det i fanen Generell under Delte oppsett."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhada. ID do registro: %@\nEla aguarda revisão e só fica pública depois de publicada. Você pode apagá-la quando quiser na aba Geral, em Configurações compartilhadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено. ID записи: %@\nНабор ждет проверки и не станет общедоступным, пока его не опубликуют. Удалить его можно в любой момент на вкладке «Общее» в разделе «Отправленные наборы»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşıldı. Kayıt kimliği: %@\nİnceleme bekliyor ve yayımlanana kadar herkese açık değil. İstediğiniz zaman Genel sekmesinde, Paylaşılan yapılandırmalar altından silebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслано. ID запису: %@\nНабір чекає на перевірку й не стане публічним, доки його не опублікують. Видалити його можна будь-коли на вкладці «Загальні» в розділі «Спільні набори»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã chia sẻ. ID bản ghi: %@\nCấu hình đang chờ duyệt và chưa công khai cho đến khi được đăng. Bạn có thể xóa nó bất cứ lúc nào trong tab Chung, mục Cấu hình đã chia sẻ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已分享。記錄ID：%@\n設定正在等候審查，發佈前不會公開。你可以隨時在「一般」標籤頁的「已分享的設定」下刪除它。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已分享。记录 ID：%@\n它正在等待审核，发布之前不会公开。您可以随时在“通用”标签页的“共享设置”下删除它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已分享。記錄ID：%@\n設定正在等待審核，發布前不會公開。您隨時可以在「一般」標籤頁的「已分享的設定」下刪除它。"
          }
        }
      }
    },
    "community-share.done.token-not-saved" : {
      "comment" : "Shown after sending if the local file with the delete key couldn't be written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The delete key couldn't be saved on this Mac, so the app can't delete this setup. Note the record ID to ask for its deletion."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč pro smazání se na tomto Macu nepodařilo uložit, takže aplikace toto nastavení smazat nemůže. Poznamenejte si ID záznamu, abyste mohli o smazání požádat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Löschschlüssel konnte auf diesem Mac nicht gespeichert werden, daher kann die App diese Belegung nicht löschen. Notiere dir die Eintrags-ID, um die Löschung anzufragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la clave de eliminación en este Mac, así que la aplicación no puede eliminar esta configuración. Apunta el ID del registro para pedir que la eliminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de suppression n'a pas pu être enregistrée sur ce Mac, donc l'app ne pourra pas supprimer cette configuration. Notez l'ID de l'enregistrement pour demander sa suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile salvare la chiave di eliminazione su questo Mac, quindi l'app non può eliminare questa configurazione. Annota l'ID record per chiederne l'eliminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除用キーをこのMacに保存できなかったため、アプリからはこの設定を削除できません。削除を依頼するときのために、レコードIDを控えておいてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 삭제 키를 저장하지 못해 앱에서 이 구성을 삭제할 수 없습니다. 삭제를 요청하려면 레코드 ID를 적어 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slettenøkkelen kunne ikke lagres på denne Macen, så appen kan ikke slette dette oppsettet. Noter post-ID-en hvis du vil be om å få det slettet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar a chave de exclusão neste Mac, então o app não consegue apagar esta configuração. Anote o ID do registro para pedir a exclusão dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить ключ удаления на этом Mac, поэтому приложение не сможет удалить этот набор. Запишите ID записи, чтобы запросить его удаление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silme anahtarı bu Mac'e kaydedilemedi, bu yüzden uygulama bu yapılandırmayı silemez. Silinmesini istemek için kayıt kimliğini not edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти ключ видалення на цьому Mac, тож програма не зможе видалити цей набір. Запишіть ID запису, щоб попросити про видалення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không lưu được khóa xóa trên máy Mac này, nên ứng dụng không thể xóa cấu hình này. Hãy ghi lại ID bản ghi để yêu cầu xóa nó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除密鑰無法儲存在此Mac上，因此App無法刪除此設定。請記下記錄ID，以便要求刪除。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除密钥无法保存在这台 Mac 上，因此 App 无法删除此设置。请记下记录 ID，以便申请删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將刪除金鑰儲存在這台Mac上，因此應用程式無法刪除這組設定。請記下記錄ID，以便要求刪除。"
          }
        }
      }
    },
    "community-share.unavailable.no-server" : {
      "comment" : "Shown in the share sheet and in Settings when the app has no server URL for sharing.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing isn't available yet: this version of the app has no server address for shared setups. Nothing is sent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílení zatím není k dispozici: tato verze aplikace nemá adresu serveru pro sdílená nastavení. Nic se neodesílá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen ist noch nicht verfügbar: Diese Version der App hat keine Serveradresse für geteilte Belegungen. Es wird nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no se puede compartir: esta versión de la aplicación no tiene dirección de servidor para las configuraciones compartidas. No se envía nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage n'est pas encore disponible : cette version de l'app n'a pas d'adresse de serveur pour les configurations partagées. Rien n'est envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione non è ancora disponibile: questa versione dell'app non ha un indirizzo server per le configurazioni condivise. Non viene inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有はまだ利用できません。このバージョンのアプリには、共有設定用のサーバのアドレスがありません。何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 공유를 사용할 수 없습니다: 이 버전의 앱에는 공유 구성용 서버 주소가 없습니다. 아무것도 전송되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deling er ikke tilgjengelig ennå: denne versjonen av appen har ingen serveradresse for delte oppsett. Ingenting blir sendt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento ainda não está disponível: esta versão do app não tem endereço de servidor para configurações compartilhadas. Nada é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делиться пока нельзя: в этой версии приложения нет адреса сервера для общих наборов. Ничего не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşım henüz kullanılamıyor: uygulamanın bu sürümünde paylaşılan yapılandırmalar için bir sunucu adresi yok. Hiçbir şey gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ділитися поки не можна: у цій версії програми немає адреси сервера для спільних наборів. Нічого не надсилається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa thể chia sẻ: phiên bản ứng dụng này không có địa chỉ máy chủ cho cấu hình chia sẻ. Không có gì được gửi đi."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫時未能分享：此版本的App沒有共享設定的伺服器地址。不會傳送任何內容。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法分享：此版本的 App 没有共享设置的服务器地址。不会发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前還無法分享：此版本的應用程式沒有分享設定用的伺服器位址。不會傳送任何內容。"
          }
        }
      }
    },
    "community-share.unavailable.switch-off" : {
      "comment" : "Shown in the share sheet when the 'Community setups' switch is off.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing is off. Turn on Community setups in the General tab to share. Nothing is sent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílení je vypnuté. Chcete-li sdílet, zapněte v záložce Obecné volbu Nastavení komunity. Nic se neodesílá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen ist aus. Schalte im Tab „Allgemein“ „Belegungen der Community“ ein, um zu teilen. Es wird nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir está desactivado. Activa Configuraciones de la comunidad en la pestaña General para compartir. No se envía nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage est désactivé. Activez Configurations de la communauté dans l'onglet Général pour partager. Rien n'est envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione è disattivata. Per condividere, attiva Configurazioni della community nel pannello Generale. Non viene inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有はオフです。共有するには、「一般」タブで「コミュニティの設定」をオンにしてください。何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유가 꺼져 있습니다. 공유하려면 일반 탭에서 커뮤니티 구성을 켜세요. 아무것도 전송되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deling er slått av. Slå på Fellesskapsoppsett i fanen Generell for å dele. Ingenting blir sendt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento está desativado. Ative Configurações da comunidade na aba Geral para compartilhar. Nada é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправка выключена. Чтобы поделиться, включите «Наборы сообщества» на вкладке «Общее». Ничего не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşım kapalı. Paylaşmak için Genel sekmesinde Topluluk yapılandırmaları'nı açın. Hiçbir şey gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмін вимкнено. Щоб поділитися, увімкніть «Набори спільноти» на вкладці «Загальні». Нічого не надсилається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng chia sẻ đang tắt. Hãy bật Cấu hình cộng đồng trong tab Chung để chia sẻ. Không có gì được gửi đi."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享已關閉。請在「一般」標籤頁開啟「社群設定」來分享。不會傳送任何內容。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享已关闭。要分享，请在“通用”标签页中打开“社区设置”。不会发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享功能已關閉。若要分享，請在「一般」標籤頁開啟「社群設定」。不會傳送任何內容。"
          }
        }
      }
    },
    "community-share.problem.bundle-id" : {
      "comment" : "Share sheet error.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app can't be shared, because its bundle ID isn't in the allowed format."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto aplikaci nelze sdílet, protože její ID balíku nemá povolený formát."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App kann nicht geteilt werden, weil ihre Bundle-ID nicht im erlaubten Format ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aplicación no se puede compartir porque su ID de paquete no tiene el formato permitido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de partager cette app, car son identifiant de paquet (bundle ID) n'a pas le format autorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app non si può condividere, perché il suo bundle ID non è nel formato consentito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのバンドルIDは許可された形式ではないため、共有できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
