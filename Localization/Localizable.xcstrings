    "effect.smart-zoom.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přiblížení nebo oddálení v Safari a dalších aplikacích.\n\nFunguje jako dvojité klepnutí dvěma prsty na Apple Trackpad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoome rein oder raus in Safari und anderen Apps.\n \nFunktioniert wie mit zwei Fingern doppelt tippen auf einem Apple Trackpad."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom in or out in Safari and other apps.\n \nWorks like a two-finger double tap on an Apple Trackpad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acercar o alejar en Safari y otras aplicaciones.\n\nFunciona como un doble toque con dos dedos en un Apple Trackpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom en avant ou en arrière dans Safari et d'autres apps.\n \nFonctionne comme un Toucher deux fois sur un Trackpad Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandisci o riduci in Safari e in altre app.\n \nFunziona come un doppio tocco con due dita su un trackpad Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safariやその他の対応アプリで拡大・縮小します。Appleトラックパッドの2本指ダブルタップ操作を再現します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari 등의 앱에서 콘텐츠를 확대하거나 축소합니다.\n \n이는 Apple 트랙패드에서 두 손가락으로 이중 탭하는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplie ou reduza o zoom no Safari e em outros apps.\n \nFunciona como um toque duplo com dois dedos em um Trackpad da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличивайте или уменьшайте масштаб в Safari и других программах.\n\nРаботает как двойное касание двумя пальцами на трекпаде Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari'de ve diğer uygulamalarda yakınlaştırma veya uzaklaştırma yapın.\n\nApple İzleme Dörtgenindede iki parmakla çift dokunma gibi çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збільшуйте або зменшуйте масштаб у Safari та інших програмах. Працює як подвійне клацання двома пальцями на трекпеді Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phóng to hoặc thu nhỏ trong Safari và các ứng dụng khác.\n \nHoạt động như nhấp bằng hai ngón tay trên Apple Trackpad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Safari和其他应用程序中放大或缩小。\n \n作用相当于在Apple触控板上用双指轻点两下"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Safari和其他應用程式中放大或縮小。\n \n作用相當於在Apple觸控式軌跡板上用兩指點兩下"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Safari和其他應用程式中放大或縮小。\n \n作用相當於在Apple觸控板上用兩指點兩下"
          }
        }
      }
    },
