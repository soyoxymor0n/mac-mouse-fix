    "settings-transfer.import.alert.message" : {
      "comment" : "Body of the alert shown before importing settings.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your buttons, scrolling and pointer settings, and app tabs will be replaced with the ones in the file. Settings that aren't in the file are set to their defaults."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše nastavení tlačítek, scrolování a ukazatele i záložky aplikací budou nahrazeny těmi ze souboru. Nastavení, která v souboru nejsou, se vrátí na výchozí hodnoty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Tasten-, Scroll- und Zeigereinstellungen sowie deine App-Tabs werden durch die aus der Datei ersetzt. Was nicht in der Datei steht, wird auf den Standard zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus ajustes de botones, desplazamiento y puntero, y tus pestañas de aplicación, se reemplazarán por los del archivo. Los ajustes que no estén en el archivo vuelven a sus valores predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos boutons, vos réglages de défilement et de pointeur ainsi que vos onglets d'apps seront remplacés par ceux du fichier. Les réglages absents du fichier reprennent leur valeur par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni di pulsanti, scorrimento e puntatore e i pannelli delle app verranno sostituiti con quelli del file. Quello che nel file manca torna ai valori predefiniti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタン、スクロール、ポインタの設定とアプリのタブが、ファイルの内容に置き換えられます。ファイルに含まれない設定は初期設定に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버튼, 스크롤, 포인터 설정과 앱 탭이 파일에 있는 내용으로 대체됩니다. 파일에 없는 설정은 기본값으로 돌아갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillingene for knapper, rulling og peker blir erstattet med dem i filen, og det samme gjelder appfanene. Innstillinger som ikke finnes i filen, settes til standardverdiene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus ajustes de botões, rolagem e ponteiro, além das abas de apps, serão substituídos pelos do arquivo. Ajustes que não estão no arquivo voltam ao padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши настройки кнопок, прокрутки и указателя, а также вкладки приложений будут заменены настройками из файла. Настройки, которых нет в файле, получат значения по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğme, kaydırma ve imleç ayarlarınız ile uygulama sekmeleriniz dosyadakilerle değiştirilecek. Dosyada olmayan ayarlar varsayılan değerlerine döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші кнопки, налаштування прокрутки й курсора та вкладки програм буде замінено тими, що у файлі. Налаштування, яких у файлі немає, повернуться до типових."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt nút, cuộn, con trỏ và các tab ứng dụng của bạn sẽ được thay bằng cài đặt trong tệp. Những cài đặt không có trong tệp sẽ về mặc định."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的按鈕、捲動和指標設定，以及App標籤頁，都會被檔案中的設定取代。檔案中沒有的設定會還原為預設值。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的按键、滚动和指针设置以及 App 标签页将被替换为文件中的设置。文件中没有的设置会恢复为默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的按鈕、捲動與指標設定，以及應用程式標籤頁，都會被檔案中的設定取代。檔案中沒有的設定會回復為預設值。"
          }
        }
      }
    },
    "settings-transfer.import.alert.newer-version" : {
      "comment" : "Extra paragraph in the import alert. %@ is the app version that wrote the file, e.g. '3.2.0'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file was exported from a newer version of Mac Mouse Fix (%@). Settings this version doesn't know are kept but may have no effect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento soubor byl exportován z novější verze Mac Mouse Fix (%@). Nastavení, která tato verze nezná, se zachovají, ale nemusí mít žádný účinek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei wurde mit einer neueren Version von Mac Mouse Fix exportiert (%@). Einstellungen, die diese Version nicht kennt, bleiben erhalten, wirken aber eventuell nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo se exportó desde una versión más reciente de Mac Mouse Fix (%@). Los ajustes que esta versión no conoce se conservan, pero puede que no tengan efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier a été exporté depuis une version plus récente de Mac Mouse Fix (%@). Les réglages que cette version ne connaît pas sont conservés, mais risquent de n'avoir aucun effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file è stato esportato da una versione più recente di Mac Mouse Fix (%@). Le impostazioni che questa versione non conosce vengono mantenute, ma potrebbero non avere effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはMac Mouse Fixの新しいバージョン（%@）で書き出されました。このバージョンが認識しない設定は保持されますが、効果がない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 최신 버전의 Mac Mouse Fix(%@)에서 내보낸 것입니다. 이 버전이 모르는 설정은 유지되지만 적용되지 않을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne filen ble eksportert fra en nyere versjon av Mac Mouse Fix (%@). Innstillinger som denne versjonen ikke kjenner, beholdes, men har kanskje ingen effekt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo foi exportado de uma versão mais nova do Mac Mouse Fix (%@). Ajustes que esta versão não conhece são mantidos, mas podem não ter efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл экспортирован из более новой версии Mac Mouse Fix (%@). Незнакомые этой версии настройки сохранятся, но могут не работать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosya Mac Mouse Fix'in daha yeni bir sürümünden (%@) dışa aktarıldı. Bu sürümün tanımadığı ayarlar korunur ama etkisi olmayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей файл експортовано з новішої версії Mac Mouse Fix (%@). Налаштування, яких ця версія не знає, буде збережено, але вони можуть не діяти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp này được xuất từ phiên bản Mac Mouse Fix mới hơn (%@). Các cài đặt mà phiên bản này chưa biết vẫn được giữ, nhưng có thể không có tác dụng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案由較新版本的Mac Mouse Fix（%@）輸出。此版本不認識的設定會保留，但可能沒有作用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件由更新版本的 Mac Mouse Fix（%@）导出。此版本无法识别的设置会被保留，但可能不起作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案是從較新版本的Mac Mouse Fix（%@）輸出。此版本無法辨識的設定會保留，但可能沒有作用。"
          }
        }
      }
    },
