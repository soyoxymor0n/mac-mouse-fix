    "scroll-effect.volume.hint" : {
      "comment" : "",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll up to turn the volume up and down to turn it down"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunutím nahoru zvýšíte hlasitost, posunutím dolů ji snížíte"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach oben scrollen, um die Lautstärke zu erhöhen, nach unten, um sie zu verringern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate hacia arriba para subir el volumen y hacia abajo para bajarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler vers le haut pour augmenter le volume et vers le bas pour le baisser"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l'alto per alzare il volume e verso il basso per abbassarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上にスクロールすると音量が上がり、下にスクロールすると音量が下がります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위로 스크롤하면 볼륨이 올라가고, 아래로 스크롤하면 볼륨이 내려갑니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rull opp for å øke volumet og ned for å senke det"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role para cima para aumentar o volume e para baixo para diminuí-lo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутка вверх увеличивает громкость, вниз уменьшает её"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi artırmak için yukarı, azaltmak için aşağı kaydırın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутка вгору збільшує гучність, вниз зменшує її"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn lên để tăng âm lượng, cuộn xuống để giảm âm lượng"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上捲動可調高音量，向下捲動則調低"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上滚动可调大音量，向下滚动则调小"
          }
        },
        "zh-Hant" : {
