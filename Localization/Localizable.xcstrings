        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повертайте вміст в Apple Maps та інших програмах\n \nПрацює як поворот двома пальцями на трекпеді Apple"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoay nội dung trên Apple Maps and và các ứng dụng khác\n \nHoạt động như vặn hai ngón tay trên Apple Trackpad"
          }
        },
        "zh-Hans" : {
