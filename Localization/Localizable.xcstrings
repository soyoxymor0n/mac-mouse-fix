    "drag-effect.dock-swipe.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohybujte myší:\n- Nahoru pro zobrazení Mission Control\n- Dolů pro zobrazení oken aplikací\n- Doleva nebo doprava pro pohyb mezi Plochami\n\nFunguje jako přejetí třemi prsty na Apple Trackpadu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege deine Maus nach:\n - Oben um Mission Control zu öffnen\n - Unten um Programmfenster zu zeigen\n - Links oder rechts um zwischen Spaces zu wechseln\n \nFunktioniert wie Streichen mit 3 Fingern auf einem Apple Trackpad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move your mouse:\n - Up to show Mission Control\n - Down to show Application Windows\n - Left or Right to move between Spaces\n \nWorks like swiping with 3 fingers on an Apple Trackpad"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueva el ratón:\n - Hacia arriba para mostrar el Mission Control\n - Hacia abajo para mostrar Ventanas de Aplicación\n - Hacia la Izquierda o la Derecha para moverse entre Espacios\n\nFunciona como deslizar con 3 dedos en un Apple Trackpad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Déplacer votre souris :\n - Vers le haut pour afficher Mission Control\n - Vers le bas pour afficher Fenêtres de l'application\n - Vers la gauche ou la droite pour passer d'un espace à un autre\n \nFonctionne comme le balayage à 3 doigts sur un Trackpad Apple"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muovi il mouse:\n - Verso l'alto per mostrare Mission Control\n - Verso il basso per mostrare Finestre dell'applicazione\n - A sinistra o a destra per passare da uno Space all'altro\n \nFunziona come scorrere con 3 dita su un trackpad Apple"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスを動かす：\n-上に動かしてMission Controlを表示\n-下に動かしてアプリケーションウィンドウを表示\n-左右に動かしてスペース間を移動\n\nAppleトラックパッドの「3本指でスワイプ」と同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스를 움직여 다음 동작을 수행합니다.:\n - 위로 올리면 Mission Control을 엽니다.\n - 아래로 내리면 현재 앱에 대해 열린 모든 윈도우를 보여줍니다.\n - 좌우로 움직이면 생성한 Spaces 사이를 이동합니다.\n \n이는 Apple 트랙패드에서 세 손가락으로 스와이프하는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mova o Mouse:\n - Para cima para mostrar o Mission Control\n - Para baixo para mostrar as Janelas do Aplicativo Aberto\n - Esquerda ou Direita para mover entre os Espaços da Mesa\n \nFunciona como deslizar com três dedos em um Trackpad da Apple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двигайте мышь:\n - Вверх, чтобы показать Mission Control\n - Вниз, чтобы показать Окна программы\n - Влево или Вправо, чтобы перемещаться между Spaces\n\nРаботает как свайп тремя пальцами на трекпаде Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farenizi:\n- Mission Control'u göstermek için yukarı doğru\n- Uygulama Pencelerini göstermek için aşağıya doğru\n- Space'ler arasında hareket ettirmek için sağa ve sola doğru hareket ettirin\n\nApple İzleme Dörtgeninde üç parmakla sağa ve sola kaydırma hareketi gibi çalışmaktadır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть вашу мишу:\n - Вверх щоб показати Mission Control\n - Вниз щоб показати App Exposé\n - Ліворуч або Праворуч щоб переміститись між Просторами\n \nПрацює як проведення 3 пальцями по трекпеду Apple"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển chuột:\n - Hướng lên để truy cập Mission Control\n - Hướng xuống để truy cập Application Windows\n - Qua trái hoặc phải để di chuyển giữa các Spaces\n \nHoạt động như vuốt 3 ngón tay trên Apple Trackpad"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动您的鼠标：\n・向上来显示调度中心\n・向下来显示应用程序窗口\n・向左或向右来切换空间\n \n作用相当于在Apple触控板上用三指滑动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動您的滑鼠：\n・向上來顯示指揮中心\n・向下來顯示應用程式視窗\n・向左或向右來切換空間\n \n作用相當於在Apple觸控式軌跡板上用三指滑動"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動你的滑鼠：\n・向上來顯示指揮中心\n・向下來顯示應用程式視窗\n・向左或向右來切換「空間」\n \n作用相當於在Apple觸控板上用三指滑動"
          }
        }
      }
    },
