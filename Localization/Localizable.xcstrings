          }
        }
      }
    },
    "app-presets.review.global-overlap" : {
      "comment" : "Note in the review sheet. %1$@ is a list of mouse button names that also have a row for all apps. %2$@ is the app name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also set for all apps: %1$@. In %2$@ these rows take precedence."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaveno i pro všechny aplikace: %1$@. V %2$@ mají přednost tyto řádky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch für alle Apps eingestellt: %1$@. In %2$@ haben diese Zeilen Vorrang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También configurado para todas las aplicaciones: %1$@. En %2$@ tienen prioridad estas filas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi configuré pour toutes les apps : %1$@. Dans %2$@, ces lignes ont la priorité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già impostati per tutte le app: %1$@. In %2$@ valgono queste righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアプリにも設定されています: %1$@。%2$@ではこれらの行が優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱에도 설정됨: %1$@. %2$@에서는 이 행이 우선합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Også angitt for alle apper: %1$@. I %2$@ har disse radene forrang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também definido para todos os apps: %1$@. No %2$@, estas linhas têm prioridade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также задано для всех приложений: %1$@. В %2$@ действуют эти строки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm uygulamalar için de ayarlı: %1$@. %2$@ içinde bu satırlar önceliklidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також налаштовано для всіх програм: %1$@. У %2$@ діють ці рядки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cũng đã thiết lập cho mọi ứng dụng: %1$@. Trong %2$@, các dòng này được ưu tiên."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
