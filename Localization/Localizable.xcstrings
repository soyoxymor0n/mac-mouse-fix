    "effect.look-up" : {
      "comment" : "Note: 'Look Up' is a feature for looking up words in the dictionary and other places. It can be triggered by pressing Command-Control-D, or by a 'force click' on a Trackpad. \n\nApple uses the term 'Look Up' at\nSystem Settings > Trackpad > Point & Click > Look up & data detectors (in macOS Tahoe)\nThey also have support website about the feature.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhledat a Rychlý náhled"
          }
        },
