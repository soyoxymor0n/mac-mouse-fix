    "mail-alert.body" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen zřídka můžu odpovídat, ale čtu si všechny zprávy a zpětná vazba mi pomáhá vylepšit Mac Mouse Fix NG. Děkuji za vaši zpětnou vazbu!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann nur selten antworten, aber ich lese alle Nachrichten und das Feedback hilft mir dabei, Mac Mouse Fix NG zu verbessern. Danke für dein Feedback!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can only rarely respond, but I read all messages and the feedback helps me improve Mac Mouse Fix NG. Thank you for your feedback!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo puedo responder en raras ocasiones, pero leo todos los mensajes y los comentarios me ayudan a mejorar Mac Mouse Fix NG. ¡Gracias por tus comentarios!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lis et j'apprécie tous vos e-mails, bien que je ne puisse pas répondre à tout le monde"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso rispondere solo raramente, ma leggo tutti i messaggi e i feedback mi aiutano a migliorare Mac Mouse Fix NG. Grazie per il tuo feedback!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個別にお返事することは稀ですが、お送りいただいたメッセージはすべて拝見しております。皆様からのフィードバックはMac Mouse Fix NGの改善に非常に役立っております。貴重なご意見をありがとうございます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "전부 답장할 수는 없지만, 항상 모든 이메일을 읽어보고 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado pelo seu feedback! Leio e aprecio todos os e-mails, faço o possível para responder todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я могу отвечать только изредка, но я читаю все сообщения, и ваши отзывы помогают мне улучшать Mac Mouse Fix NG. Спасибо за ваши отзывы!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ütün e-postalara geri dönemesem de hepsini okuyorum ve takdir ediyorum"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я відповідаю рідко, але читаю всі повідомлення, і ваші відгуки допомагають мені вдосконалювати Mac Mouse Fix NG. Дякую за ваш відгук!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi có thể hiếm khi phản hồi, nhưng Tôi đọc tất cả tin nhắn và thông tin phản hồi giúp tôi cải thiện Mac Mouse Fix NG. \nCảm ơn thông tin phản hồi của bạn! "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我可能无法及时回复邮件，但我会认真阅读所有的意见和建议，感谢您的反馈！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "我無法回覆所有的郵件，但我會閱讀並感謝所有的使用者意見"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "我無法回覆所有的郵件，但我會閱讀並感謝所有的用戶意見"
          }
        }
      }
    },
