    "scroll-effect.4-pinch.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolujte nahoru pro Launchpad a dolů pro zobrazení Desktopu.\n\nFunguje jako sevření 4 prsty na Apple trackpadu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle nach oben für Launchpad und nach unten um den Schreibtisch zu zeigen\n \nFunktioniert wie Aufziehen mit 4 Fingern auf einem Apple Trackpad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll up for Launchpad and down to show the Desktop\n \nWorks like Pinching with 4 fingers on an Apple Trackpad"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate hacia arriba para Launchpad y hacia abajo para mostrar el Escritorio\n\nFunciona como pellizcar con 4 dedos en un Apple Trackpad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défiler vers le haut pour le Launchpad et vers le bas pour afficher le Burean \nFonctionne comme le pincement avec 4 doigts sur un Trackpad Apple"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l'alto per Launchpad e verso il basso per mostrare la scrivania\n \nFunziona come pizzicare con 4 dita su un trackpad Apple"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上にスクロールしてLaunchpadを表示、下にスクロールしてデスクトップを表示\n\nAppleトラックパッドの「4本指でピンチ」と同じように動作します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위로 스크롤하면 Launchpad를 열며, 아래로 스크롤하면 데스크탑 화면을 봅니다.\n \n이는 Apple 트랙패드에서 네 손가락을 오므리거나 펼치는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role para cima para acessar o Launchpad e para baixo para exibir a Mesa\n \nFunciona como pinçar com quatro dedos em um Trackpad da Apple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутите вверх, чтобы открыть Launchpad, и вниз, чтобы отобразить рабочий стол\n \nРаботает как сжатие 4 пальцами на трекпаде Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpad için yukarı kaydırın ve Masaüstünü göstermek için aşağı kaydırın\n \nApple İzleme Dörtgeninde 4 parmağı birleştirmek gibi çalışır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутіть вгору для Launchpad і вниз, щоб показати робочий стіл\n \nПрацює як розведення/зведення 4 пальців на трекпеді Apple"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn lên để hiện Launchpad và  xuống để hiện Desktop\n \nHoạt động như chụm bốn ngón tay trên Apple Trackpad"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上滚动来显示启动台，向下滚动来显示桌面\n \n作用相当于在Apple触控板上四指张开或捏拢"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上捲動來顯示啟動台，向下捲動來顯示桌面\n \n作用相當於在Apple觸控式軌跡板上四指分開或靠攏"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上捲動來顯示啟動台，向下捲動來顯示桌面\n \n作用相當於在Apple觸控板上四指分開或收合"
          }
        }
      }
    },
