    "scroll-effect.rotate.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otáčejte zobrazení v Apple mapách a dalších aplikacích.\n\nFunguje jako otáčení 2 prsty an Apple trackpadu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe den Inhalt in Apple Maps und anderen Apps\n \nFunktioniert wie Drehen mit 2 Fingern auf einem Apple Trackpad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
