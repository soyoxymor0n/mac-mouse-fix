      }
    },
    "app-presets.review.intro" : {
      "comment" : "Explanation at the top of the review sheet of a built-in preset for an app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what to use. You can change the button or the action of any row, or untick it."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, co chcete použít. U každého řádku můžete změnit tlačítko nebo akci, případně ho odškrtnout."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle aus, was du verwenden willst. Bei jeder Zeile kannst du Taste oder Aktion ändern oder das Häkchen entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué quieres usar. Puedes cambiar el botón o la acción de cualquier fila, o desmarcarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce que vous voulez garder. Vous pouvez changer le bouton ou l'action de chaque ligne, ou la décocher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa usare. In ogni riga puoi cambiare il pulsante o l'azione, oppure deselezionarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使うものを選んでください。各行のボタンやアクションは変更でき、チェックを外すこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용할 항목을 선택하세요. 각 행의 버튼이나 동작을 바꾸거나 체크를 해제할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hva du vil bruke. Du kan endre knappen eller handlingen i hver rad, eller fjerne avkrysningen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que usar. Você pode trocar o botão ou a ação de qualquer linha, ou desmarcá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что использовать. В любой строке можно сменить кнопку или действие либо снять отметку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne kullanacağınızı seçin. Her satırın düğmesini veya eylemini değiştirebilir ya da işaretini kaldırabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, що використовувати. У кожному рядку можна змінити кнопку чи дію або зняти позначку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn những gì bạn muốn dùng. Bạn có thể đổi nút hoặc tác vụ của từng dòng, hay bỏ chọn dòng đó."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要使用的項目。你可以更改任何一列的按鈕或動作，或取消勾選。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要使用的项目。每一行的按键或操作都可以修改，也可以取消勾选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要使用的項目。每一列的按鈕或動作都可以更改，也可以取消勾選。"
          }
        }
      }
    },
