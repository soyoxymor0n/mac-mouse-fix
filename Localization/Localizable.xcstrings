          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom in or out in Safari, Maps and other apps\n \nWorks like pinching to zoom on an Apple trackpad"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acercar o alejar en Safari, Mapas y otras aplicaciones\n\nFunciona como pellizcar para hacer zoom en un trackpad de Apple"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomer en avant ou en arrière dans Safari, Plans et d'autres apps\n \nFonctionne comme le pincement pour zoomer sur un Trackpad Apple"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandisci o riduci in Safari, Mappe e altre app\n \nFunziona come pizzicare per fare zoom su un trackpad Apple"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari、マップ、その他のアプリで拡大・縮小\n\nAppleトラックパッドでの「ピンチしてズーム」と同じように動作します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari, 지도 등의 앱에서 콘텐츠를 확대 또는 축소합니다.\n \n이는 Apple 트랙패드에서 두 손가락을 오므리거나 펼쳐서 확대 또는 축소하는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar ou diminuir o zoom no Safari, no Maps e em outros apps\n \nFunciona como pinçar para ampliar em um Trackpad da Apple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличивайте или уменьшайте масштаб в Safari, Картах и других программах\n\nРаботает как жест «щипок для масштабирования» на трекпаде Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari, Maps ve diğer uygulamalarda yakınlaştırın ve uzaklaştırın\n\nApple İzleme Dörtgeninde iki parmakla kıstırma/açma gibi çalışır\n"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінюйте масштаб у Safari, Картах та інших програмах\n \nПрацює як масштабування пальцями на трекпеді Apple"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phóng to hoặc thu nhỏ trên Safari, Maps và các ứng dụng khác\n \nHoạt động như chụm hai ngón tay để phóng to trên Apple trackpad"
