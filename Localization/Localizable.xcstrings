                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Ostatní aplikace tato tlačítka již nevidí."
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Ostatní aplikace toto tlačítko již nevidí."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Ostatní aplikace tato tlačítka již nevidí."
                    }
                  }
                }
