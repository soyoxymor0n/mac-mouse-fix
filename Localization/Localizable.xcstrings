    "scroll-effect.spaces.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunutím nahoru se posunete o jednu mezeru doleva a dolů se posunete o jednu mezeru doprava.\n\nFunguje jako vodorovné přejetí třemi prsty na Apple Trackpadu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle nach oben um einen Space nach links zu wechseln und nach unten um einen Space nach rechts zu wechseln\n \nFunktioniert wie horizontales Wischen mit 3 Fingern auf einem Apple Trackpad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll up to move left a Space and down to move right a Space\n \nWorks like swiping horizontally with 3 fingers on an Apple Trackpad"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate hacia arriba para moverte un Espacio a la izquierda y hacia abajo para moverte un Espacio a la derecha\n\nFunciona como deslizar horizontalmente con 3 dedos en un Apple Trackpad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Défiler vers le haut pour se déplacer d'un espace vers la gauche et vers le bas pour se déplacer d'un espace vers la droite\n \nFonctionne comme le balayage horizontal avec 3 doigts sur un Trackpad Apple"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l'alto per spostarti di uno Space a sinistra e verso il basso per spostarti di uno Space a destra\n \nFunziona come scorrere in orizzontale con 3 dita su un trackpad Apple"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上にスクロールして左のスペースへ移動、下にスクロールして右のスペースへ移動\n\nAppleトラックパッドでの「3本指で左右にスワイプ」と同じように動作します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위로 스크롤하면 좌측 Space로 이동하며, 아래로 스크롤하면 우측 스페이스로 이동합니다.\n \n이는 Apple 트랙패드에서 세 손가락으로 수평 스와이프하는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Role para cima para mover um espaço para a esquerda e para baixo para mover um espaço para a direitain Funciona como deslizar horizontalmente com 3 dedos em um Trackpad da Apple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутите вверх, чтобы переместиться влево на одно пространство, и вниз, чтобы переместиться вправо на одно пространство\n \nРаботает как горизонтальное перемещение тремя пальцами по трекпаду Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Space sola gitmek için yukarı kaydırın ve bir Space sağa gitmek için aşağı kaydırın\n \nApple İzleme Dörtgeninde 3 parmakla yatay olarak kaydırma gibi çalışır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутіть вгору, щоб перейти ліворуч на Простір, і вниз, щоб перейти праворуч\n \nПрацює як проведення трьома пальцями по трекпеду Apple"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn lên để di chuyển qua Space bên trái và xuống để di chuyển qua Space bên phải\n \nHoạt động như vuốt ngang ba ngón tay trên Apple Trackpad"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上滚动来向左移动一个空间，向下滚动来向右移动一个空间\n \n作用相当于在Apple触控板上用三指左右滑动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
