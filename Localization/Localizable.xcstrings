          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi un pulsante del mouse due volte di seguito, velocemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスのボタンをすばやく2回押します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 버튼을 빠르게 두 번 누릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
