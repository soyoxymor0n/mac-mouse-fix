    "scroll-effect.zoom.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přiblížení nebo oddálení v Safari, Mapách a dalších aplikacích\n\nFunguje jako přiblížení na trackpadu Apple sevřením prstů."
          }
        },
        "de" : {
          "stringUnit" : {
