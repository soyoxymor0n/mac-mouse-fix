          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses réglages de boutons seront aussi supprimés. Les réglages globaux ne changent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono eliminate anche le sue impostazioni dei pulsanti. Le impostazioni per tutte le app restano invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタブのボタン設定も削除されます。すべてのアプリ用の設定は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 탭의 버튼 설정도 함께 삭제됩니다. 전체 설정은 영향을 받지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knappeinnstillingene i fanen slettes også. Globale innstillinger påvirkes ikke."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
