    "scroll-effect.horizontal.hint" : {
      "comment" : "",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posouvání doleva a doprava, procházení stránek v Safari, mazání zpráv v Mailu a další\n\nFunguje jako horizontální přejetí dvěma prsty na Apple Trackpadu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle nach links und rechts, blättere zwischen Seiten in Safari, lösche Nachrichten in Mail, und mehr\n \nFunktioniert wie horizontales Wischen mit 2 Fingern auf einem Apple Trackpad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll left and right, navigate between pages in Safari, delete messages in Mail and more\n \nWorks like swiping horizontally with 2 fingers on an Apple Trackpad"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate hacia la izquierda y hacia la derecha, navega entre páginas en Safari, elimina mensajes en Mail y más\n\nFunciona como deslizar horizontalmente con 2 dedos en un Apple Trackpad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défiler sur la gauche et la droite, naviguer entre les pages sur Safari, supprimer les messages dans Mail et bien plus\n \nFonctionne comme le balayage horizontal avec un Trackpad Apple"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a sinistra e a destra, passa da una pagina all'altra in Safari, elimina i messaggi in Mail e altro ancora\n \nFunziona come scorrere in orizzontale con 2 dita su un trackpad Apple"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右にスクロール、Safariでのページ間移動、メールでのメッセージ削除などが可能です。\n\nAppleトラックパッドでの「2本指で左右にスワイプ」と同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌우로 스크롤하여 Safari에서는 페이지를 쓸어넘길 수 있으며, Mail에선 메시지를 삭제할 수도 있습니다.\n \n이는 Apple 트랙패드에서 두 손가락으로 스와이프하는 것과 같습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role para a esquerda e para a direita, navegue entre páginas no Safari, exclua mensagens no Mail e muito mais\n \nFunciona como deslizar horizontalmente com dois dedos em um Trackpad da Apple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручивайте влево и вправо, перемещайтесь между страницами в Safari, удаляйте сообщения в Почте и многое другое\n\nРаботает как горизонтальный свайп двумя пальцами на трекпаде Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sola ve sağa kaydırın, Safari'de sayfalar arasında gezinin, Mail'deki mesajları silin ve daha fazlasını yapın\n \nApple İzleme Dörtgeninde 2 parmakla yatay olarak kaydırma gibi çalışır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручуйте вліво та вправо, переходьте між сторінками в Safari, видаляйте повідомлення в Пошті та багато іншого\n \nПрацює як проведення двома пальцями по трекпеду Apple"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn trái và phải, điều hướng giữa các trang của Safari, xóa các mẫu tin trong Mail, và nhiều hơn.\n \nHoạt động như vuốt ngang hai ngón tay trên Apple Trackpad"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左和向右滚动来导航Safari页面、删除“邮件”中的邮件等\n \n作用相当于在Apple触控板上用双指左右轻扫"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左和向右捲動來導覽Safari頁面、刪除「郵件」中的郵件等\n \n作用相當於在Apple觸控式軌跡板上用兩指左右滑動"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左和向右捲動來導覽Safari頁面、刪除「郵件」中的郵件等\n \n作用相當於在Apple觸控板上用兩指左右滑動"
          }
        }
      }
    },
