    "revive-toast" : {
      "comment" : "Note: \"%1$@\" will be a list of mouse features like \"Scrolling\" or \"Buttons\" for which Mac Mouse Fix was enabled. \"%2$@\" will be the menu bar icon.\n\nNote 2: \"&nbsp;\" Creates a \"non-breaking space\" character which prevents the menu bar icon from ending up \"orphaned\" on a separate line from the \"Menu Bar\" text.\n\nNote 3: The mentioned feature in the menu bar lets you disable Mac Mouse Fix's effect on your mouse-buttons/scroll-wheel directly from the menubar. The feature is aimed at temporarily disabling specific features while working with an incompatible app. To permanently disable the features, users should change the settings in the main app instead of the menu bar. Perhaps you can phrase this so it's a bit more obvious than in English? But really, the design should change.\n\nNote 4: The word 'enable' in this context doesn't necessarily have to match the 'Enable Mac Mouse Fix' switch I think.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Mac Mouse Fix NG **Povolena** pro %1$@\nByla zakázána v Menu&nbsp;Bar&nbsp;%2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Mouse Fix NG **aktiviert** für %1$@\nEs war in der Menüleiste&nbsp;%2$@ deaktiviert worden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Enabled** Mac Mouse Fix NG for %1$@\nIt had been disabled from the Menu&nbsp;Bar&nbsp;%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Activado** Mac Mouse Fix NG para %1$@\nHabía sido desactivado desde la Barra&nbsp;de&nbsp;menús&nbsp;%2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac Mouse Fix NG **activé** pour %1$@\nIl a été désactivé depuis la barre des menus %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac Mouse Fix NG è stato **attivato** per %1$@\nEra stato disattivato dalla barra&nbsp;dei&nbsp;menu&nbsp;%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でMac Mouse Fix NGを**有効**にしました\nメニューバー%2$@から無効に設定されていました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@에 대한 Mac Mouse Fix NG 동작이 **다시 활성화**되었습니다.\n이는 사용자에 의해 메뉴 막대 %2$@ 에서 수동으로 비활성화되어있었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Aktivert** Mac Mouse Fix NG for %1$@\nDen hadde blitt deaktivert fra Menu&nbsp;Bar&nbsp;%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Habilitado** Mac Mouse Fix NG para %1$@\nEle foi desabilitado na barra de menu %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Включён** Mac Mouse Fix NG для %1$@\nОн был отключён из Строки&nbsp;меню&nbsp;%2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ için Mac Mouse Fix NG **etkinleştirildi**\nMenü Bar %2$@ alanından devre dışı bırakılmıştı"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Увімкнено** Mac Mouse Fix NG для %1$@\nЦе було відключено з меню&nbsp;Bar&nbsp;%2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Đã kích hoạt** Mac Mouse Fix NG cho %1$@\nNó đã bị tắt từ thanh menu %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**已启用**Mac Mouse Fix调校：%1$@\n此前由菜单栏%2$@停用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**已啟用**Mac Mouse Fix調校：%1$@\n此前由選單列%2$@停用"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "**已啟用**Mac Mouse Fix調校：%1$@\n此前由選單列%2$@停用"
          }
        }
      }
    },
