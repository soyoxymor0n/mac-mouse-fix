          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn một nút chuột hai lần thật nhanh."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速連按滑鼠按鈕兩下。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速连按鼠标按键两下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速連按滑鼠按鈕兩下。"
          }
        }
      }
    },
    "add-field.explainer.hold" : {
      "comment" : "Line in the gestures popover that opens from the question mark in the add field. Explains the gesture 'Hold'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press a mouse button and keep it held for a moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte tlačítko myši a chvíli ho držte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Maustaste drücken und kurz gedrückt halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa un botón del ratón y mantenlo pulsado un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un bouton de la souris et gardez-le enfoncé un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi un pulsante del mouse e tienilo premuto per un attimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスのボタンを押して、少しのあいだ押したままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 버튼을 누른 채로 잠시 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en museknapp og hold den inne et øyeblikk."
          }
        },
